  "mapping_notes": {
    "mossy_oak": "wiki has NO 'Mossy Oak' tree file (File:Mossy prefix only contains Mossy_Seed.png). Closest official art = Green Rain Tree type 1, whose files are named 'Wild Tree Stage N.png'. Oak/Maple trees turn into this type in Fall.",
    "mossy_pine": "wiki has NO 'Mossy Pine' tree file. Closest official art = Green Rain Tree type 3, the pine-shaped one, files named 'Fiddlehead Stalk Stage N.png'.",
    "greenrain": "'Green Rain Tree' is not a file name on the wiki. The three official variants are: type 1 = 'Wild Tree ...', type 2 = 'Lush Wild Tree ...', type 3 = 'Fiddlehead Stalk ...'. Type 2 is used here so greenrain does not duplicate mossy_oak; type 1 -> mossy_oak, type 3 -> mossy_pine.",
    "mushroom": "stage files are 'MushroomTree Stage N.png' (no space, no 'Tree' word) while the portrait is 'Mushroom tree portrait.png'.",
    "mystic": "uses 'Mystic Tree Stage N.png' (with the word 'Tree'), unlike oak/maple/pine/mahogany which omit it.",
    "mahogany": "portrait is capitalised 'Mahogany Tree Portrait.png' while the stages are 'Mahogany Stage N.png'.",
    "palm": "only 3 growth stages exist; portraits: 'Palm tree portrait.png' (desert) and 'Palm Tree Island Portrait.png' + 'Palm Tree Island Portrait Fruit.png' (island).",
    "fruit_trees": "no '<Fruit> Tree.png' single sprite exists. Each fruit tree = '<Fruit> Stage 1..5.png' + '<Fruit> Stage 5 Fruit.png' (mature tree carrying fruit), plus the fruit item '<Fruit>.png' and the sapling '<Fruit> Sapling.png'."
  }
